bgatch/tsa/raw/d7809d058936aa98773671cb259b5b8ac2e586ec/README.md","contents_url":"https://api.github.com/repos/bbgatch/tsa/contents/README.md?ref=d7809d058936aa98773671cb259b5b8ac2e586ec","patch":"@@ -1,2 +1,6 @@\n # tsa\n-TSA checkpoint data.\n+The `tsa-data.py` code automates the process of pulling data from the TSA website. The TSA began publishing traveler numbers due to the coronavirus pandemic to help monitor the impact on air travel.\n+\n+The `revision-check.py` code checks for any revisions in prior daily data. The TSA website notes that past data can be periodically updated. This code could be further updated to be more flexible.\n+\n+Data is pulled from this site: https://www.tsa.gov/coronavirus/passenger-throughput"},{"sha":"eac2a1b2de0bf9b354ba340b84a4ef82941c6652","filename":"images/tsa_trav_2020-07-21.png","status":"added","additions":0,"deletions":0,"changes":0,"blob_url":"https://github.com/bbgatch/tsa/blob/d7809d058936aa98773671cb259b5b8ac2e586ec/images%2Ftsa_trav_2020-07-21.png","raw_url":"https://github.com/bbgatch/tsa/raw/d7809d058936aa98773671cb259b5b8ac2e586ec/images%2Ftsa_trav_2020-07-21.png","contents_url":"https://api.github.com/repos/bbgatch/tsa/contents/images%2Ftsa_trav_2020-07-21.png?ref=d7809d058936aa98773671cb259b5b8ac2e586ec"},{"sha":"f657487df9955b3882981e382e5b3adca01a8bcc","filename":"images/tsa_wow_2020-07-21.png","status":"added","additions":0,"deletions":0,"changes":0,"blob_url":"https://github.com/bbgatch/tsa/blob/d7809d058936aa98773671cb259b5b8ac2e586ec/images%2Ftsa_wow_2020-07-21.png","raw_url":"https://github.com/bbgatch/tsa/raw/d7809d058936aa98773671cb259b5b8ac2e586ec/images%2Ftsa_wow_2020-07-21.png","contents_url":"https://api.github.com/repos/bbgatch/tsa/contents/images%2Ftsa_wow_2020-07-21.png?ref=d7809d058936aa98773671cb259b5b8ac2e586ec"},{"sha":"49d559748316d4f8b76882e4cb44cc1ae2468d6e","filename":"tsa.csv","status":"modified","additions":1,"deletions":0,"changes":1,"blob_url":"https://github.com/bbgatch/tsa/blob/d780